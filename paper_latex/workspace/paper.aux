\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Hallucination rate (fraction of proof steps not backed by text span or bridge axiom) on RuleTaker and CLUTRR. Typed failure recovery reduces hallucination by 35.5\% on RuleTaker (from 12.9\% baseline to 8.3\% typed) and 32.3\% on CLUTRR (from 57.1\% baseline to 38.7\% typed). Higher hallucination on CLUTRR reflects the goal extractor's inability to handle relational variable binding (kinship queries), a property-extraction bottleneck orthogonal to repair.}}{9}{figure.2}\protected@file@percent }
\newlabel{fig:hallucination}{{2}{9}{Hallucination rate (fraction of proof steps not backed by text span or bridge axiom) on RuleTaker and CLUTRR. Typed failure recovery reduces hallucination by 35.5\% on RuleTaker (from 12.9\% baseline to 8.3\% typed) and 32.3\% on CLUTRR (from 57.1\% baseline to 38.7\% typed). Higher hallucination on CLUTRR reflects the goal extractor's inability to handle relational variable binding (kinship queries), a property-extraction bottleneck orthogonal to repair}{figure.2}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {5.2.2}CLUTRR Results}{9}{subsubsection.5.2.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Results on CLUTRR (100 examples).}}{9}{table.2}\protected@file@percent }
\newlabel{tab:clutrr}{{2}{9}{Results on CLUTRR (100 examples)}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Distribution of failure types detected by the typed classifier. RuleTaker shows predominantly Type-3 (missing fact) failures (15 of 100) with no Type-1 or Type-4 failures, reflecting the dataset's synthetic, property-rich facts. CLUTRR shows mixed failure types: 4 Type-1 (lexical mismatch, e.g., `mother' vs `parent'), 60 Type-3 (missing transitive rules for kinship chains), 36 with no failure. Zero Type-2, Type-4, and Type-5 failures in both datasets. The prevalence of Type-3 on CLUTRR and Type-1 on CLUTRR kinship examples validates the five-type taxonomy's expressiveness.}}{10}{figure.3}\protected@file@percent }
\newlabel{fig:failures}{{3}{10}{Distribution of failure types detected by the typed classifier. RuleTaker shows predominantly Type-3 (missing fact) failures (15 of 100) with no Type-1 or Type-4 failures, reflecting the dataset's synthetic, property-rich facts. CLUTRR shows mixed failure types: 4 Type-1 (lexical mismatch, e.g., `mother' vs `parent'), 60 Type-3 (missing transitive rules for kinship chains), 36 with no failure. Zero Type-2, Type-4, and Type-5 failures in both datasets. The prevalence of Type-3 on CLUTRR and Type-1 on CLUTRR kinship examples validates the five-type taxonomy's expressiveness}{figure.3}{}}
